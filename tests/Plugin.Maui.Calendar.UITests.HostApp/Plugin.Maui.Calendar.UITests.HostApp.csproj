<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The app the UI tests drive (tests/Plugin.Maui.Calendar.UITests). Every page is a scenario that shows a
		calendar in a fixed state: today is May 14 2025, the culture is en-US and the theme is light, so the
		screenshots and texts the tests check never depend on the day or the device they run on.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<!-- There are no iOS and Mac Catalyst workloads on Linux, where the app can only be built for Android. -->
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Plugin.Maui.Calendar.UITests.HostApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<IsPackable>false</IsPackable>

		<ApplicationTitle>Calendar UI Tests</ApplicationTitle>
		<ApplicationId>com.plugin.maui.calendar.uitests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<!-- Appium installs the APK itself, so it has to contain the assemblies (Debug builds use fast deployment otherwise). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<!--
		dotnet publish -f net10.0-ios -c Release -p:UITestNativeAot=true builds the app with Native AOT for the iOS
		simulator, which trims every assembly fully, to run the UI tests against it (UITEST_APP). Set here rather than
		on the command line, where PublishAot and the runtime identifier would also reach the library's other targets.
	-->
	<PropertyGroup Condition="'$(UITestNativeAot)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PublishAot>true</PublishAot>
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#e5e5e5" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Plugin.Maui.Calendar\Plugin.Maui.Calendar.csproj" />
	</ItemGroup>

</Project>
