<?xml version="1.0" encoding="utf-8" ?>
<!--
    The built-in day cell: a background layer and a content layer, both placed directly in the
    container of a DayView. They are templates so that DayView only creates them when no
    DayViewTemplate is set (see DayView.xaml.cs). One instance of this dictionary is shared by all
    cells of all calendars (DefaultDayTemplates.Shared), so a cell does not allocate its own
    dictionary, templates and converter. The converter is a static field rather than a resource, so
    the templates use it directly instead of looking it up for every cell.
-->
<ResourceDictionary
    x:Class="Plugin.Maui.Calendar.Controls.DefaultDayTemplates"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Plugin.Maui.Calendar.Controls"
    xmlns:models="clr-namespace:Plugin.Maui.Calendar.Models">
    <DataTemplate x:Key="DefaultDayBackgroundTemplate" x:DataType="models:DayModel">
        <Border
            Padding="0"
            Margin="{Binding DayViewBorderMargin, Mode=OneWay}"
            BackgroundColor="{Binding BackgroundColor, Mode=OneWay}"
            MaximumHeightRequest="{Binding DayViewSize, Mode=OneWay}"
            HorizontalOptions="Fill"
            Stroke="{Binding OutlineColor, Mode=OneWay}"
            StrokeShape="{Binding DayViewCornerRadius, Converter={x:Static local:DefaultDayTemplates.StrokeShapeConverter}, Mode=OneWay}"
            MaximumWidthRequest="{Binding DayViewSize, Mode=OneWay}"
            VerticalOptions="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="DefaultDayContentTemplate" x:DataType="models:DayModel">
        <FlexLayout
            AlignItems="Center"
            Direction="{Binding EventLayoutDirection}"
            JustifyContent="Center">
            <Grid HeightRequest="4"/>
            <Label
                HorizontalTextAlignment="Center"
                Style="{Binding DaysLabelStyle, Mode=OneWay}"
                Text="{Binding Day, Mode=OneWay}"
                TextColor="{Binding TextColor, Mode=OneWay}"/>
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding EventColors, Mode=OneWay}" HeightRequest="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="Color">
                        <Border
                            Padding="0"
                            BackgroundColor="{Binding ., Mode=OneWay}"
                            HeightRequest="8"
                            StrokeShape="RoundRectangle 4"
                            WidthRequest="8"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </FlexLayout>
    </DataTemplate>
</ResourceDictionary>
