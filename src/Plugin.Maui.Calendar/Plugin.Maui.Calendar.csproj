<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
		<!-- There are no iOS and Mac Catalyst workloads on Linux, where only the other targets can be built. -->
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		 <!--<TargetFrameworks>$(TargetFrameworks);net6.0-tizen</TargetFrameworks> -->
		<UseMaui>true</UseMaui>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
		<!-- Enable Source Generators for XAML in .NET 10 -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<!--  <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> -->
    
		<!--
			Runs the trimming, AOT and single-file analyzers on all platforms, so code that is not safe for trimming or
			Native AOT shows up as build warnings. The library is deliberately not marked trimmable (IsTrimmable or
			IsAotCompatible): apps then keep all of it in their default partial trimming, so reflection-based bindings
			to its members (templates without x:DataType) keep working in Release. Native AOT and full trimming trim it anyway.
		-->
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
		<!-- Without this, the MAUI build turns the trim analyzer off and hides its warnings (xamarin/xamarin-macios#21351) -->
		<_MauiDoNotConfigureTrimAnalyzer>true</_MauiDoNotConfigureTrimAnalyzer>
    
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- NuGet -->
		<Authors>yurkinh</Authors>
		<Copyright>Copyright © yurkinh and contributors</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageVersion>4.0.0</PackageVersion>
		<IsPackable>True</IsPackable>
		<PackageProjectUrl>https://github.com/yurkinh/Plugin.Maui.Calendar</PackageProjectUrl>
		<RepositoryUrl>https://github.com/yurkinh/Plugin.Maui.Calendar</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>dotnet-maui;maui;calendar;calendar control</PackageTags>
		<IncludeSymbols>True</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>.NET MAUI Calendar Control Plugin</Title>
		<Description>Highly customizable Calendar Control for a .NET MAUI application.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<DebugType>portable</DebugType>
		<PackageIcon>nuget.png</PackageIcon>
		<PackageReleaseNotes>
                        * Breaking: the package no longer depends on CommunityToolkit.Mvvm; an app that uses the toolkit adds the package itself
                        * Breaking: DayTappedMessage is removed; use DayTappedCommand to react to taps
                        * Added TimeProvider: tells the calendar which day is today, so tests and screenshots can pin it
                        * Added DayViewHeight: the height of the day cells, while DayViewSize stays their width, so a DayViewTemplate can list the events of a day in a month grid
                        * Added observed day collections: a day of the EventCollection stored as an ObservableCollection&lt;T&gt; updates its cell and the event list when its events change (#20)
                        * Added runtime SwipeDetectionDisabled: it can be changed at any time
                        * Fix: the arrows and swipes stay within MinimumDate and MaximumDate, and the year arrows raise MonthChanged
                        * Fix: week numbers are counted from FirstDayOfWeek, and cultures with a non-Gregorian calendar show Gregorian month names and years
                        * Fix: crashes with ShownDate set to default(DateTime), near the ends of DateTime, with Events or Culture set to null, and in Native AOT apps when the footer was shown
                        * Fix: on Android a swipe that starts on a day changes the month
                        * Fix: a calendar whose handler is replaced by another one keeps handling day taps and changes of Events (#270)
                        * The full list is in CHANGELOG.md
    </PackageReleaseNotes>
	</PropertyGroup>	

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup> 
	<ItemGroup>

	  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />		
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Shared\" />
	  <None Remove="Shared\Models\" />
	  <None Remove="Shared\Controls\" />
	  <None Remove="Shared\Converters\" />
	</ItemGroup>
	
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Plugin.Maui.Calendar.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Shared\Models\" />
	  <Folder Include="Shared\Converters\" />
	</ItemGroup>
	<!-- Package additions -->
	<ItemGroup>
		<None Include="..\..\nuget.png" PackagePath="nuget.png" Pack="true" />
		<None Include="..\..\README.md" PackagePath="README.md" Pack="true" />
		<!-- Reference for AI coding assistants, shipped so it matches the installed version -->
		<None Include="..\..\llms-full.txt" PackagePath="llms-full.txt" Pack="true" />
	</ItemGroup>	
</Project>
