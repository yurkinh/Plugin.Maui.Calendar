<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SampleApp.Controls.ThemeButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleApp.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="This"
    x:DataType="local:ThemeButton">
    <ContentView.Resources>
        <ControlTemplate x:Key="RadioButtonTemplate">
            <ContentPresenter />
        </ControlTemplate>

        <Style TargetType="RadioButton">
            <Setter Property="ControlTemplate" Value="{StaticResource RadioButtonTemplate}" />
        </Style>

        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        </Style>
    </ContentView.Resources>

    <!--
        Both looks are laid out and IsChecked only switches which one is visible: DataTrigger
        setters with AppThemeResource colors are not reverted reliably once the app theme changes.
    -->
    <RadioButton GroupName="{Binding GroupName, Source={x:Reference This}}" IsChecked="{Binding IsChecked, Source={x:Reference This}, Mode=TwoWay}">
        <RadioButton.Content>
            <Grid>
                <Border
                    BackgroundColor="{toolkit:AppThemeResource SurfaceColor}"
                    IsVisible="{Binding IsChecked, Source={x:Reference This}, Converter={StaticResource InvertedBoolConverter}}"
                    Stroke="{toolkit:AppThemeResource DividerColor}"
                    StrokeThickness="1"
                    Style="{StaticResource CardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label
                            FontFamily="FontAwesomeSolid"
                            FontSize="22"
                            HorizontalOptions="Center"
                            Text="{Binding Icon, Source={x:Reference This}}"
                            TextColor="{toolkit:AppThemeResource TextSecondaryColor}" />
                        <Label
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="{Binding Title, Source={x:Reference This}}"
                            TextColor="{toolkit:AppThemeResource TextPrimaryColor}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{toolkit:AppThemeResource AccentSoftColor}"
                    IsVisible="{Binding IsChecked, Source={x:Reference This}}"
                    Stroke="{toolkit:AppThemeResource AccentColor}"
                    StrokeThickness="2"
                    Style="{StaticResource CardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label
                            FontFamily="FontAwesomeSolid"
                            FontSize="22"
                            HorizontalOptions="Center"
                            Text="{Binding Icon, Source={x:Reference This}}"
                            TextColor="{toolkit:AppThemeResource AccentColor}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="{Binding Title, Source={x:Reference This}}"
                            TextColor="{toolkit:AppThemeResource AccentColor}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </RadioButton.Content>
    </RadioButton>
</ContentView>
