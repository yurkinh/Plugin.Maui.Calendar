<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="SampleApp.Controls.CalendarEvent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SampleApp.Model"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="models:AdvancedEventModel">
    <Grid
        Padding="16,10"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="12">
        <BoxView
            CornerRadius="2"
            WidthRequest="4"
            Color="{toolkit:AppThemeResource AccentColor}" />
        <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label FontAttributes="Bold" FontSize="15">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Starting, StringFormat='{0:HH\\:mm}'}" TextColor="{toolkit:AppThemeResource AccentColor}" />
                        <Span Text="  " />
                        <Span Text="{Binding Name}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label
                LineBreakMode="WordWrap"
                Style="{StaticResource CaptionLabelStyle}"
                Text="{Binding Description}" />
        </VerticalStackLayout>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
