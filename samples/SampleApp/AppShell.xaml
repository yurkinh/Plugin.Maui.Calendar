<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="SampleApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleApp.Views;assembly=SampleApp"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Calendar"
    Shell.BackgroundColor="{toolkit:AppThemeResource PageBackgroundColor}"
    Shell.FlyoutBehavior="Disabled"
    Shell.ForegroundColor="{toolkit:AppThemeResource AccentColor}"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{toolkit:AppThemeResource SurfaceColor}"
    Shell.TabBarForegroundColor="{toolkit:AppThemeResource AccentColor}"
    Shell.TabBarTitleColor="{toolkit:AppThemeResource AccentColor}"
    Shell.TabBarUnselectedColor="{toolkit:AppThemeResource TextSecondaryColor}"
    Shell.TitleColor="{toolkit:AppThemeResource TextPrimaryColor}">
    <TabBar>
        <Tab Title="Samples" Icon="calendar">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Settings" Icon="settings">
            <ShellContent ContentTemplate="{DataTemplate local:UserSettingPage}" Route="UserSettingPage" />
        </Tab>
    </TabBar>
</Shell>
