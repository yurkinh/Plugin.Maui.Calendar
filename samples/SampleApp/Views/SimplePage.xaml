<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.SimplePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SampleApp.Controls"
    xmlns:local="clr-namespace:SampleApp.ViewModels"
    xmlns:models="clr-namespace:SampleApp.Model"
    xmlns:mtk="clr-namespace:MemoryToolkit.Maui;assembly=MemoryToolkit.Maui"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    x:Name="simpleCalendarPage"
    Title="Simple Calendar"
    mtk:LeakMonitorBehavior.Cascade="True"
    x:DataType="local:SimplePageViewModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding TodayCommand}" Text="Today" />
        <controls:XamlSourceToolbarItem />
    </ContentPage.ToolbarItems>
    <plugin:Calendar
        x:Name="calendar"
        AllowDeselecting="False"
        Day="{Binding Day}"
        DayViewBorderMargin="6,4,6,8"
        EmptyTemplate="{StaticResource NoEventsTemplate}"
        Events="{Binding Events}"
        EventsScrollViewVisible="True"
        MaximumDate="{Binding MaximumDate}"
        MinimumDate="{Binding MinimumDate}"
        Month="{Binding Month}"
        MonthChangedCommand="{Binding MonthChangedCommand}"
        OtherMonthWeekIsVisible="False"
        SelectedDate="{Binding SelectedDate}"
        Style="{StaticResource SampleCalendarStyle}"
        SwipeDetectionDisabled="False"
        Year="{Binding Year}">
        <plugin:Calendar.EventTemplate>
            <DataTemplate x:DataType="models:EventModel">
                <controls:EventRow Command="{Binding EventSelectedCommand, Source={RelativeSource AncestorType={x:Type local:SimplePageViewModel}}, x:DataType=local:SimplePageViewModel}" />
            </DataTemplate>
        </plugin:Calendar.EventTemplate>
    </plugin:Calendar>
</ContentPage>
