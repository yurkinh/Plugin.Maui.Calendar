<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.WeekSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SampleApp.Controls"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    Title="Week Selection"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <controls:XamlSourceToolbarItem />
    </ContentPage.ToolbarItems>
    <plugin:WeekSelectionCalendar Style="{StaticResource SampleCalendarStyle}" />
</ContentPage>
