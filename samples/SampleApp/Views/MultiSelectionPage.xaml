<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.MultiSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SampleApp.Controls"
    xmlns:local="clr-namespace:SampleApp.ViewModels"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    x:Name="multiCalendarPage"
    Title="Multi Selection"
    x:DataType="local:SimplePageViewModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding TodayCommand}" Text="Today" />
        <controls:XamlSourceToolbarItem />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,24">
            <plugin:MultiSelectionCalendar
                x:Name="calendar"
                Events="{Binding Events}"
                MaximumDate="{Binding MaximumDate}"
                MinimumDate="{Binding MinimumDate}"
                Month="{Binding Month}"
                SelectedDate="{Binding SelectedDate}"
                SelectedDates="{Binding SelectedDates, Mode=TwoWay}"
                Style="{StaticResource SampleCalendarStyle}"
                Year="{Binding Year}">
                <!--  The footer lists every selected date: CalendarFooter cuts the list at the screen edge  -->
                <plugin:MultiSelectionCalendar.FooterSectionTemplate>
                    <DataTemplate>
                        <controls:CalendarFooter />
                    </DataTemplate>
                </plugin:MultiSelectionCalendar.FooterSectionTemplate>
            </plugin:MultiSelectionCalendar>

            <Grid
                Margin="16,8,16,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
                <Label
                    Style="{StaticResource CaptionLabelStyle}"
                    Text="{Binding SelectedDates.Count, StringFormat='{0} days selected'}"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ClearSelectedDatesCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="Clear Selection" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
