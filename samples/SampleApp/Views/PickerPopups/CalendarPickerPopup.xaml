<?xml version="1.0" encoding="utf-8" ?>
<rg:PopupPage
    x:Class="SampleApp.Views.CalendarPickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleApp.ViewModels"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    xmlns:rg="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:CalendarPickerPopupViewModel"
    BackgroundColor="{toolkit:AppThemeResource ScrimColor}"
    CloseWhenBackgroundIsClicked="False">

    <rg:PopupPage.BindingContext>
        <local:CalendarPickerPopupViewModel />
    </rg:PopupPage.BindingContext>

    <rg:PopupPage.Content>
        <Border
            Margin="16"
            Padding="0,20,0,12"
            BackgroundColor="{toolkit:AppThemeResource SurfaceColor}"
            MaximumWidthRequest="380"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="0"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label
                    Margin="20,0"
                    Style="{StaticResource TitleLabelStyle}"
                    Text="Choose Date" />
                <plugin:Calendar
                    x:Name="calendar"
                    FooterSectionVisible="False"
                    MaximumDate="{Binding MaximumDate}"
                    MinimumDate="{Binding MinimumDate}"
                    SelectedDate="{Binding SelectedDate}"
                    Style="{StaticResource SampleCalendarStyle}"
                    SwipeUpToHideEnabled="False" />
                <Grid
                    Margin="12,8,12,0"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="8">
                    <Button
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource TextButtonStyle}"
                        Text="Clear" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="Cancel" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding SuccessCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="Select" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </rg:PopupPage.Content>
</rg:PopupPage>
