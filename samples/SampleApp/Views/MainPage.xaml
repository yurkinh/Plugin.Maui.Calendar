<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:SampleApp.Model"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SampleApp.ViewModels"
    Title="Samples"
    x:DataType="vm:MainPageViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,32">
            <VerticalStackLayout Margin="20,8,20,0" Spacing="4">
                <Label
                    FontSize="26"
                    Style="{StaticResource TitleLabelStyle}"
                    Text="Plugin.Maui.Calendar" />
                <Label Style="{StaticResource CaptionLabelStyle}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Tap a sample to open it. On a sample page, " />
                            <Span
                                FontFamily="FontAwesomeSolid"
                                Text="&#xf121;"
                                TextColor="{toolkit:AppThemeResource AccentColor}" />
                            <Span Text=" shows the XAML of its calendar." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:DemoGroup">
                        <VerticalStackLayout>
                            <Label Style="{StaticResource SectionHeaderStyle}" Text="{Binding Title}" />
                            <Border Margin="16,0" Style="{StaticResource CardStyle}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="model:DemoItem">
                                            <Grid
                                                Padding="14,0,0,0"
                                                AutomationId="{Binding Title}"
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="14"
                                                RowDefinitions="*,Auto"
                                                SemanticProperties.Description="{Binding Title}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                                </Grid.GestureRecognizers>

                                                <Border
                                                    Padding="0"
                                                    BackgroundColor="{toolkit:AppThemeResource AccentSoftColor}"
                                                    HeightRequest="38"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center"
                                                    WidthRequest="38">
                                                    <Label Style="{StaticResource IconLabelStyle}" Text="{Binding Glyph}" />
                                                </Border>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Padding="0,12"
                                                    Spacing="2"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        Style="{StaticResource BodyLabelStyle}"
                                                        Text="{Binding Title}" />
                                                    <Label Style="{StaticResource CaptionLabelStyle}" Text="{Binding Description}" />
                                                </VerticalStackLayout>

                                                <Label
                                                    Grid.Column="2"
                                                    Margin="0,0,16,0"
                                                    FontFamily="FontAwesomeSolid"
                                                    FontSize="12"
                                                    Text="&#xf054;"
                                                    TextColor="{toolkit:AppThemeResource TextDisabledColor}"
                                                    VerticalOptions="Center" />

                                                <BoxView
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    IsVisible="{Binding ShowDivider}"
                                                    Style="{StaticResource DividerStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
