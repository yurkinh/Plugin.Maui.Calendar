<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SampleApp.Controls"
    xmlns:mtk="clr-namespace:MemoryToolkit.Maui;assembly=MemoryToolkit.Maui"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    Title="Default Calendar"
    mtk:LeakMonitorBehavior.Cascade="True"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <controls:XamlSourceToolbarItem />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="12">
            <Label x:Name="ShownDatesLabel" Style="{StaticResource CaptionLabelStyle}" />

            <!--
                The library defaults are made for a light background, so this card stays
                white in the dark theme as well.
            -->
            <Border
                Padding="8,0,8,8"
                BackgroundColor="White"
                Style="{StaticResource CardStyle}">
                <plugin:Calendar
                    x:Name="CalendarControl"
                    ShownDatesChanged="OnShownDatesChanged"
                    Style="{StaticResource SettingsCalendarStyle}" />
            </Border>

            <Label Style="{StaticResource CaptionLabelStyle}" Text="Only the language and the first day of the week from Settings are applied. Everything else is the library default." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
